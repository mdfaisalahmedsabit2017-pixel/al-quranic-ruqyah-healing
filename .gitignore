.vercel

# ~4GB of extracted audio — lives in R2/object storage, never in git
audio_files/

# Build outputs. `public/` is what Vercel serves, `native/` is what Capacitor
# packs into the APK; both are regenerated by build.js on every build.
public/
native/

# PDFs that pdf_list.json does not reference — parked here rather than deleted,
# but they must never ship or be deployed again.
pdf_archive/

# The paid book's page images. THIS REPOSITORY IS PUBLIC — committing these
# would hand out the whole book for free and make the /api/book purchase gate
# pointless. They reach production through the Vercel function's includeFiles,
# not through git.
book_pages/

# Signing material must never be committed.
*.jks
*.keystore
keystore.properties
google-services.json
