{
  "buildCommand": "node build.js --target=web",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/app", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/pdf/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/guides/(_assets|_files)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/book.js": {
      "includeFiles": "book_pages/**",
      "maxDuration": 20
    }
  }
}
