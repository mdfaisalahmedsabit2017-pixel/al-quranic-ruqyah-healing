{
  "buildCommand": "node build.js --target=web",
  "outputDirectory": "public",
  "git": { "deploymentEnabled": { "master": false } },
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/", "destination": "/app.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:section(audio|guides|blog|topics)", "destination": "/:section/", "permanent": true },
    { "source": "/:section(audio|guides|blog|topics)/:a([^./]+)", "destination": "/:section/:a/", "permanent": true },
    { "source": "/:section(audio|guides|blog|topics)/:a([^./]+)/:b([^./]+)", "destination": "/:section/:a/:b/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/pdf/:slug.pdf",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Link", "value": "<https://alquranicruqyahhealing.com/guides/pdf/:slug/>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/pdf/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/guides/(_assets|_files)/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(blog/images|guides/_previews|icons|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(blog|guides)/(.*).json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "functions": {
    "api/book.js": {
      "includeFiles": "{book_pages,book_pages_yasin,book_html_yasin,book_pages_isme_azam}/**",
      "maxDuration": 20
    },
    "api/course.js": {
      "includeFiles": "{course_data,course_notes}/**",
      "maxDuration": 20
    }
  }
}
